NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/motatto
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d
CORS_ORIGINS=http://localhost:5173,https://motattomotocicletas.com,https://www.motattomotocicletas.com
WEB_URL=http://localhost:5173
# Optional: public URL of this API (used for local /uploads links)
API_PUBLIC_URL=http://localhost:4000

# AI (label OCR + voice assistant). Leave empty to use deterministic fallbacks.
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible). Leave empty to store uploads on local disk under apps/api/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Seed
SUPERADMIN_EMAIL=superadmin@motatto.app
SUPERADMIN_PASSWORD=Motatto2026!
SEED_OWNER_PASSWORD=Motatto2026!
# Required to call POST /api/superadmin/seed-demo (header X-Seed-Token)
SEED_TOKEN=
